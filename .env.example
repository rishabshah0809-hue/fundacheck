# Use this as a template for the environment variables, or copy it to .env.
# The app works without a key too, in rule-based mode.

# xAI / Grok — preferred provider for the analyst chat.
# Key: https://console.x.ai
XAI_API_KEY=

# Optional: force a provider. With no value, the app prefers xAI when an XAI
# key exists, then preserves existing Groq/OpenRouter configurations.
# Values: xai (or grok), groq, openrouter
LLM_PROVIDER=

# Groq — free tier, fastest option. Key: https://console.groq.com/keys
GROQ_API_KEY=

# OpenRouter — free ':free' models. Key: https://openrouter.ai/keys
OPENROUTER_API_KEY=
